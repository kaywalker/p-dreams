; Engine configuration file.
; Godot 4.7

config_version=5

[application]

config/name="Liftoff - Pinball Dreams Tribute"
config/description="Flipper für den Gaming-Table, inspiriert von Pinball Dreams."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

limits/opengl/max_lights_per_object=16
lights_and_shadows/directional_shadow/size=4096

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.015, 0.04, 1)
