var buf := PackedByteArray()
var _widths := {}
var _offsets := {}


func _ready() -> void:
	buf.resize(COLS * ROWS)
	for ch in FONT:
		var rows: Array = FONT[ch]
		var lo := 5
		var hi := -1
		for r in rows:
			for col in 5:
				if int(r) & (0x10 >> col):
					lo = mini(lo, col)
					hi = maxi(hi, col)
		if hi < 0 or DIGITS.contains(ch):
			lo = 0
			hi = 4
		_offsets[ch] = lo
		_widths[ch] = hi - lo + 1
	var grid := Node2D.new()
	grid.show_behind_parent = true
	add_child(grid)
	grid.draw.connect(_draw_grid.bind(grid))


func clear() -> void:
	buf.fill(0)


func set_px(x: int, y: int, v: int) -> void:
	if x < 0 or y < 0 or x >= COLS or y >= ROWS:
		return
	var i := y * COLS + x
	buf[i] = maxi(buf[i], v)


func fill_rect(x: int, y: int, w: int, h: int, v: int) -> void:
	for yy in range(y, y + h):
		for xx in range(x, x + w):
			set_px(xx, yy, v)


func char_width(ch: String) -> int:
	if ch == " ":
		return 3
	return int(_widths.get(ch, 5))


func text_width(s: String, scale := 1) -> int:
	s = s.to_upper()
	if s.is_empty():
		return 0
	var w := 0
	for ch in s:
		w += char_width(ch) + 1
	return (w - 1) * scale


func text(x: int, y: int, s: String, scale := 1, v := 3) -> int:
	s = s.to_upper()
	for ch in s:
		if ch != " " and FONT.has(ch):
			var rows: Array = FONT[ch]
			var off: int = _offsets[ch]
			var w := char_width(ch)
			for ry in 7:
				var bits := int(rows[ry])
				for cx in w:
					if bits & (0x10 >> (cx + off)):
						for sy in scale:
							for sx in scale:
								set_px(x + cx * scale + sx, y + ry * scale + sy, v)
		x += (char_width(ch) + 1) * scale
	return x


func text_center(y: int, s: String, scale := 1, v := 3) -> void:
	text((COLS - text_width(s, scale)) / 2, y, s, scale, v)


func text_right(x_right: int, y: int, s: String, scale := 1, v := 3) -> void:
	text(x_right - text_width(s, scale), y, s, scale, v)


## Wählt automatisch die große Schrift, wenn der Text passt.
func headline(y: int, s: String, v := 3) -> void:
	if text_width(s, 2) <= COLS - 2:
		text_center(y, s, 2, v)
	else:
		text_center(y + 4, s, 1, v)


func _draw_grid(grid: Node2D) -> void:
	var w := COLS * PITCH
	var h := ROWS * PITCH
	grid.draw_rect(Rect2(-14, -14, w + 28, h + 28), Color(0.12, 0.12, 0.16))
	grid.draw_rect(Rect2(-6, -6, w + 12, h + 12), Color(0.02, 0.01, 0.0))
	var s := PITCH * 0.72
	var o := (PITCH - s) * 0.5
	for y in ROWS:
		for x in COLS:
			grid.draw_rect(Rect2(x * PITCH + o, y * PITCH + o, s, s), OFF_COLOR)


func _process(_delta: float) -> void:
	queue_redraw()


func _draw() -> void:
	var s := PITCH * 0.78
	var o := (PITCH - s) * 0.5
	var cols: Array[Color] = [Color.TRANSPARENT, Color(ON_COLOR, 0.35), Color(ON_COLOR, 0.65), ON_COLOR]
	for y in ROWS:
		for x in COLS:
			var v := buf[y * COLS + x]
			if v > 0:
				draw_rect(Rect2(x * PITCH + o, y * PITCH + o, s, s), cols[mini(v, 3)])
